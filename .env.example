POSTGRES_PASSWORD=replace-with-a-long-database-password
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-long-pgadmin-password
GRAFANA_PASSWORD=replace-with-a-long-grafana-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
DRIVER_PASSWORD=replace-with-a-long-driver-password
CUSTOMER_PASSWORD=replace-with-a-long-customer-password
COOKIE_SECURE=false
# Optional password recovery: configure a real SMTP account; blank disables email.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=taxi@example.com
ADMIN_RESET_EMAIL=
PUBLIC_URL=http://127.0.0.1:8080
# Map demo services for student/local use; replace with own providers for production.
MAP_SEARCH_URL=https://photon.komoot.io/api/
MAP_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=TaxiBookingStudentProject/1.0 (+http://127.0.0.1:8080)

APP_DB_PASSWORD=replace-with-a-long-app-database-password
MONITOR_DB_PASSWORD=replace-with-a-long-monitor-database-password

# Optional AI support (server-side key only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
